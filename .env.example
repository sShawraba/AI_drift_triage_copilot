# ============================================================
# Drift Triage Co‑Pilot – Environment Variables
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- PostgreSQL (shared by agent & model service) ---
DATABASE_URL=postgresql://admin:admin@localhost:5432/mlops

# --- Redis (job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Phase 5 – add your API key when ready) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Groq API key (for LLM calls in Phase 5+)
GROQ_API_KEY=API_KEY_HERE
LLM_MODEL=llama-3.1-8b-instant   # or another Groq model